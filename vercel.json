{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/menu.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/waiter", "destination": "/waiter.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  }
}
