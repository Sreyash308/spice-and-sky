{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/menu.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/waiter/login", "destination": "/waiter-login.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/waiter/:path*", "destination": "/waiter.html" },
    { "source": "/waiter", "destination": "/waiter.html" },
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  }
}
